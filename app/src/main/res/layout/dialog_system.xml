<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="380dp"
    android:orientation="vertical"
    android:background="@drawable/bg_atak_panel"
    android:padding="20dp">

    <!-- ======================================================= -->
    <!-- DIALOG HEADER & TAB NAVIGATION BAR                       -->
    <!-- ======================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_gear"
            app:tint="#00FF66"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SYSTEM SETTINGS"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btnCloseSystem"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✕"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/bg_glass_btn" />
    </LinearLayout>

    <!-- SLEEK TAB NAVIGATION PILL BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_mode_switcher"
        android:padding="4dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tabInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="STATUS &amp; INFO"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:gravity="center"
            android:background="@drawable/bg_glass_btn_active"
            android:layout_marginEnd="2dp" />

        <TextView
            android:id="@+id/tabCfg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CONFIG"
            android:textColor="#888888"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:gravity="center"
            android:layout_marginEnd="2dp" />

        <TextView
            android:id="@+id/tabIsr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ISR MODE"
            android:textColor="#888888"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:gravity="center"
            android:layout_marginEnd="2dp" />

        <TextView
            android:id="@+id/tabLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LOGS"
            android:textColor="#888888"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- ======================================================= -->
    <!-- TAB CONTENT AREA                                        -->
    <!-- ======================================================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 1. INFO TAB CONTENT -->
            <LinearLayout
                android:id="@+id/layoutInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_telemetry_capsule"
                    android:layout_marginBottom="16dp">

                    <TextView android:id="@+id/tvDroneModel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MODEL: DISCONNECTED" android:textColor="#FFFFFF" android:textSize="13sp" android:layout_marginBottom="4dp" />
                    <TextView android:id="@+id/tvDroneStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DRONE: OFFLINE" android:textColor="#00FF66" android:textSize="13sp" android:layout_marginBottom="4dp" />
                    <TextView android:id="@+id/tvRCStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RC LINK: OFFLINE" android:textColor="#00FF66" android:textSize="13sp" android:layout_marginBottom="4dp" />
                    <TextView android:id="@+id/tvEngineStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MOTORS: OFF" android:textColor="#888888" android:textSize="13sp" />
                    <TextView android:id="@+id/tvSimulatorStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SIMULATOR ACTIVE" android:textColor="#FF3333" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" android:layout_marginTop="6dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSNInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[ SYSTEM SERIAL NUMBERS ]\nFetching hardware details..."
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_telemetry_capsule" />

                <Button
                    android:id="@+id/btnPair"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="INITIATE RC LINKING"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSimulator"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="HARDWARE SIMULATOR: OFF"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnTestAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="TEST SAFETY ALERTS"
                    android:textColor="#FF3333"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_glass_btn_red"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- 2. CONFIG TAB CONTENT -->
            <LinearLayout
                android:id="@+id/layoutCfg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- SENSITIVITY CONTROLS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FLIGHT &amp; GIMBAL CONTROL"
                    android:textColor="#00FF66"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnGimbalSens"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="GIMBAL SENSITIVITY: 0.2"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnFlightSens"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="FLIGHT SENSITIVITY: 1.0"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnTouchAction"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="TOUCH ACTION: GIMBAL"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnAutoSens"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="AUTO SENSITIVITY: ON"
                    android:textColor="#00FF66"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btnInvertVertical"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="INVERT Y: OFF"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:background="@drawable/bg_glass_btn"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnInvertHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="INVERT X: OFF"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:background="@drawable/bg_glass_btn" />
                </LinearLayout>

                <!-- EDGE SERVER CONFIG -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MQTT TELEMETRY EDGE SERVER"
                    android:textColor="#00FF66"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <EditText
                        android:id="@+id/etServerIp"
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:layout_height="40dp"
                        android:hint="Server IP / Host"
                        android:textColorHint="#666666"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/bg_telemetry_capsule"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/etServerPort"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:hint="Port"
                        android:textColorHint="#666666"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:inputType="number"
                        android:background="@drawable/bg_telemetry_capsule"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <EditText
                        android:id="@+id/etMqttUser"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:hint="MQTT Username"
                        android:textColorHint="#666666"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/bg_telemetry_capsule"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/etMqttPass"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:hint="MQTT Password"
                        android:textColorHint="#666666"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:inputType="textPassword"
                        android:background="@drawable/bg_telemetry_capsule"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnConnectServer"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="CONNECT MQTT SERVER"
                    android:textColor="#00FF66"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/bg_btn_outline_green"
                    android:layout_marginBottom="16dp" />

                <!-- RTMP VIDEO STREAMING CONFIG -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RTMP VIDEO BROADCASTING"
                    android:textColor="#00FF66"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etRtmpUrl"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_telemetry_capsule"
                    android:paddingHorizontal="10dp"
                    android:hint="rtmp://rtc.blackeye.id:1936/dji-sdk-view"
                    android:textColorHint="#666666"
                    android:inputType="textUri"
                    android:text="rtmp://rtc.blackeye.id:1936/dji-sdk-view"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <Button
                        android:id="@+id/btnStartRtmp"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="START RTMP"
                        android:textColor="#00FF66"
                        android:background="@drawable/bg_btn_outline_green"
                        android:textSize="11sp"
                        android:layout_marginEnd="4dp"/>
                    <Button
                        android:id="@+id/btnStopRtmp"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="STOP RTMP"
                        android:textColor="#FF3333"
                        android:background="@drawable/bg_btn_outline_red"
                        android:textSize="11sp"/>
                </LinearLayout>



                <!-- SAFETY & FAILSAFE THRESHOLDS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SAFETY &amp; FAILSAFE THRESHOLDS"
                    android:textColor="#00FF66"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnToggleRadar"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="OBSTACLE RADAR: ON"
                    android:textColor="#00FF66"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnRadarDistance"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="RADAR DISTANCE: 10m"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnRthAltitude"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="RTH ALTITUDE: 100m"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnObstacleAction"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="OBSTACLE ACTION: BRAKE"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSignalLossAction"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="SIGNAL LOSS ACTION: RETURN TO HOME"
                    android:textColor="#00FF66"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnGpsDeniedMode"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="GPS-DENIED MODE: OFF (OUTDOOR GPS)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnConfinedSpaceMode"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="CONFINED SPACE MODE: NORMAL (10m BRAKE)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnStealthMode"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="STEALTH MODE (BELLY LAMP &amp; LEDS): OFF"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnBellyLamp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="💡 BELLY LANDING LAMP: OFF"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnDistanceLimit"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="🌐 DISTANCE LIMIT: UNLIMITED (NO LIMIT)"
                    android:textColor="#00FF66"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnGpsTagsConfig"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="📍 GPS TARGET INTEL &amp; TAGS (SAVED COORDS)"
                    android:textColor="#FFFF00"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnWebOdmConfig"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="WEBODM ORTHOPHOTO CONFIG"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>

            <!-- 3. ISR MODE TAB CONTENT -->
            <LinearLayout
                android:id="@+id/layoutIsr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- ── ISR STATUS BANNER ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_telemetry_capsule"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ISR CAPTURE MODES"
                        android:textColor="#00FF66"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvIsrStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="● Mode 1: DISABLED   ● Mode 2: DISABLED"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- ── MODE 1 : HUD SCREEN CAPTURE ── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MODE 1 — HUD SCREEN CAPTURE"
                    android:textColor="#00FF66"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Captures the drone HUD view and uploads directly to Ceph S3 in real-time."
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnIsrMode1Toggle"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="MODE 1 (HUD CAPTURE): DISABLED"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <Button
                        android:id="@+id/btnIsrMode1CaptureNow"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="📸 CAPTURE NOW"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:background="@drawable/bg_glass_btn"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:id="@+id/tvMode1LastCapture"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.2"
                        android:text="Last: —"
                        android:textColor="#888888"
                        android:textSize="10sp"
                        android:gravity="center_vertical|end"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- OVERLAY TOGGLES FOR MODE 1 RECORD & STREAM -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnToggleReticleOverlay"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:text="RETICLE: ON ✓"
                        android:textColor="#00FF66"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_glass_btn"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnToggleCompassOverlay"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:text="COMPASS: ON ✓"
                        android:textColor="#00FF66"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_glass_btn" />
                </LinearLayout>

                <!-- DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#333333"
                    android:layout_marginBottom="12dp" />

                <!-- ── MODE 2 : REAL CAMERA CAPTURE / AUTO SYNC ON LANDING ── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MODE 2 — REAL CAMERA CAPTURE (SYNC ON LANDING)"
                    android:textColor="#00FF66"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="High-res native camera capture. Files are auto-downloaded and uploaded to Ceph S3 when motors stop after landing."
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnIsrMode2Toggle"
                        android:layout_width="0dp"
                        android:layout_weight="1.6"
                        android:layout_height="42dp"
                        android:text="MODE 2 (AUTO SYNC ON LAND): DISABLED"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_glass_btn"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnIsrMode2SyncNow"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="42dp"
                        android:text="🔄 SYNC NOW"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_glass_btn" />
                </LinearLayout>

                <!-- DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#333333"
                    android:layout_marginBottom="12dp" />

                <!-- ── S3 / CEPH ENDPOINT CONFIG ── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CEPH S3 STORAGE ENDPOINT"
                    android:textColor="#00FF66"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etS3ServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_telemetry_capsule"
                    android:paddingHorizontal="10dp"
                    android:hint="http://192.168.180.99:8000/data-primary/drone/isr_tasking/captured"
                    android:text="http://192.168.180.99:8000/data-primary/drone/isr_tasking/captured"
                    android:textColorHint="#666666"
                    android:inputType="textUri"
                    android:layout_marginBottom="8dp" />

                <!-- ACCESS KEY & SECRET KEY -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <EditText
                        android:id="@+id/etS3AccessKey"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:hint="S3 Access Key"
                        android:text="0RUUD1YOR1DLRQN2WF7H"
                        android:textColorHint="#666666"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:background="@drawable/bg_telemetry_capsule"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="4dp" />

                    <EditText
                        android:id="@+id/etS3SecretKey"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:hint="S3 Secret Key"
                        android:text="hfGxYhmhBjNL41NUecqyGev5a77H29JfO0DAEkBs"
                        android:textColorHint="#666666"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:inputType="textPassword"
                        android:background="@drawable/bg_telemetry_capsule"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>

                <!-- REGION & FOLDER NAMING MODE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <EditText
                        android:id="@+id/etS3Region"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:hint="Region (e.g. BT)"
                        android:text="BT"
                        android:textColorHint="#666666"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:background="@drawable/bg_telemetry_capsule"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnS3FolderModeToggle"
                        android:layout_width="0dp"
                        android:layout_weight="1.2"
                        android:layout_height="40dp"
                        android:text="FOLDER: AUTO (DATE)"
                        android:textColor="#00FF66"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_glass_btn" />
                </LinearLayout>

                <!-- CUSTOM FOLDER NAME INPUT -->
                <EditText
                    android:id="@+id/etS3CustomFolder"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_telemetry_capsule"
                    android:paddingHorizontal="10dp"
                    android:hint="Custom Folder Name (e.g. mission_alpha_01)"
                    android:textColorHint="#666666"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- S3 REMOTE FOLDER PICKER -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SELECT EXISTING S3 FOLDER"
                    android:textColor="#00FF66"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <!-- Spinner row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <Spinner
                        android:id="@+id/spinnerS3Folder"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_telemetry_capsule"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="4dp"
                        android:popupBackground="#1A1A2E"
                        android:spinnerMode="dropdown" />

                    <Button
                        android:id="@+id/btnRefreshS3Folders"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="↻ REFRESH"
                        android:textColor="#00FF66"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_glass_btn"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>

                <!-- Use selected folder button -->
                <Button
                    android:id="@+id/btnUseSelectedS3Folder"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="✓ USE SELECTED FOLDER"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_outline_green"
                    android:layout_marginBottom="8dp" />

                <!-- LOCAL FETCH DOWNLOAD FOLDER -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Local Device Download Folder"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/etLocalFetchFolder"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_telemetry_capsule"
                    android:paddingHorizontal="10dp"
                    android:hint="Local Folder Name (e.g. ISR_Mode2_Sync)"
                    android:text="ISR_Mode2_Sync"
                    android:textColorHint="#666666"
                    android:layout_marginBottom="8dp" />

                <!-- SAVE S3 CONFIG BUTTON -->
                <Button
                    android:id="@+id/btnSaveS3Config"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="SAVE S3 &amp; CEPH CONFIG"
                    android:textColor="#00FF66"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/bg_btn_outline_green"
                    android:layout_marginBottom="8dp" />

                <!-- CREATE S3 FOLDER BUTTON -->
                <Button
                    android:id="@+id/btnCreateS3Folder"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="📁 CREATE NEW S3 FOLDER"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginBottom="8dp" />

                <!-- CONNECT TO CEPH / S3 -->
                <Button
                    android:id="@+id/btnConnectCeph"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="🔗 CONNECT TO CEPH / S3"
                    android:textColor="#00FF66"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/bg_btn_outline_green"
                    android:layout_marginBottom="8dp" />

                <!-- SELECT LOCAL FOLDER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/etLocalFolderPath"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_telemetry_capsule"
                        android:paddingHorizontal="10dp"
                        android:hint="/sdcard/DCIM/ISR_Sync"
                        android:textColorHint="#666666"
                        android:textSize="11sp"
                        android:layout_marginEnd="4dp"
                        android:inputType="textUri" />

                    <Button
                        android:id="@+id/btnPickLocalFolder"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="📂 BROWSE"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_glass_btn"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>

                <!-- ISR UPLOAD STATUS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:background="@drawable/bg_telemetry_capsule"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="UPLOAD STATUS"
                        android:textColor="#00FF66"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvIsrUploadStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No uploads in progress."
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <ProgressBar
                        android:id="@+id/pbIsrUpload"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="6dp"
                        android:progress="0"
                        android:max="100"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

            <!-- 4. LOG TAB CONTENT -->
            <LinearLayout
                android:id="@+id/layoutLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/logText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="260dp"
                    android:textColor="#00FF66"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_telemetry_capsule"
                    android:padding="12dp" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
