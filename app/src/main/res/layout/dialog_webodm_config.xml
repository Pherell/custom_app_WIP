<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_atak_panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WebODM ORTHOPHOTO CONFIG"
            android:textColor="#00FF66"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="✕"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_glass_btn" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WebODM Server URL"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:background="@drawable/bg_telemetry_capsule"
        android:paddingHorizontal="10dp"
        android:inputType="textUri"
        android:hint="http://192.168.1.100:8000"
        android:textColorHint="#666666"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvLabelUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Username"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etUsername"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:background="@drawable/bg_telemetry_capsule"
        android:paddingHorizontal="10dp"
        android:inputType="text"
        android:hint="admin"
        android:textColorHint="#666666"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvLabelPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Password"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:background="@drawable/bg_telemetry_capsule"
        android:paddingHorizontal="10dp"
        android:inputType="textPassword"
        android:hint="********"
        android:textColorHint="#666666"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnFetchProjects"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="FETCH PROJECTS"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/bg_glass_btn"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvLabelProject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Target Project"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spnProjects"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_telemetry_capsule"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="SAVE CONFIGURATION"
        android:textColor="#00FF66"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_outline_green" />
</LinearLayout>
