<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_atak_panel"
    android:padding="16dp">

    <!-- HEADER TITLE & CLOSE BUTTON -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvRouteManagerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="ROUTE &amp; MISSION MANAGER"
            android:textColor="#00FF66"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCloseRouteManager"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="✕"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/bg_glass_btn" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginBottom="12dp" />

    <!-- CONTAINER FOR ROUTE ITEMS LIST -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/layoutRoutesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- ACTION BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnCreateNewRoute"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="+ NEW ROUTE"
            android:textColor="#00FF66"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline_green"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnChainExecuteRoutes"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="✈ EXECUTE ALL"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_btn" />
    </LinearLayout>

    <Button
        android:id="@+id/btnMasterClearMap"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="🗑 MASTER CLEAR MAP"
        android:textColor="#FF3333"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_outline_red" />
</LinearLayout>
