<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:keepScreenOn="true"
    tools:context=".MainActivity">

    <!-- ======================================================= -->
    <!-- 1. PRIMARY CAMERA FPV SURFACE                           -->
    <!-- ======================================================= -->
    <SurfaceView
        android:id="@+id/fpvSurface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ======================================================= -->
    <!-- 2. STRATEGY MAP OVERLAY (osmdroid)                      -->
    <!-- ======================================================= -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ======================================================= -->
    <!-- 3. AR VISION LANDING OVERLAY                            -->
    <!-- ======================================================= -->
    <com.dji.recreate2.ARLandingOverlayView
        android:id="@+id/arLandingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- HUD TARGET SQUARE RETICLE -->
    <ImageView
        android:id="@+id/reticle"
        android:layout_width="160dp"
        android:layout_height="125dp"
        android:src="@drawable/reticle_corners"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ======================================================= -->
    <!-- 4. HEADING TAPE (POSITIONED DIRECTLY ABOVE SQUARE RETICLE) -->
    <!-- ======================================================= -->
    <com.dji.recreate2.CompassView
        android:id="@+id/compassView"
        android:layout_width="220dp"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/reticle"
        app:layout_constraintStart_toStartOf="@id/reticle"
        app:layout_constraintEnd_toEndOf="@id/reticle" />

    <!-- TOUCH FOCUS RETICLE -->
    <ImageView
        android:id="@+id/focusReticle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_focus_reticle"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- LRF RETICLE & READOUT -->
    <ImageView
        android:id="@+id/lrfReticle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_focus_reticle"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvLrfData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LRF: OFF"
        android:textColor="#00FF66"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:background="@drawable/bg_telemetry_capsule"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/lrfReticle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp" />

    <!-- ======================================================= -->
    <!-- 5. TOP DYNAMIC ATAK TELEMETRY HEADER                    -->
    <!-- ======================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_atak_header"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- C2 SERVER STATUS & SIGNAL CAPSULE -->
        <LinearLayout
            android:id="@+id/capsuleSignal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_telemetry_capsule"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ivSignalIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_signal"
                app:tint="#00FF66" />

            <TextView
                android:id="@+id/tvServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="C2: 100%"
                android:textColor="#00FF66"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <!-- DYNAMIC CENTER METRICS CONTAINER -->
        <LinearLayout
            android:id="@+id/containerMetrics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            app:layout_constraintStart_toEndOf="@id/capsuleSignal"
            app:layout_constraintEnd_toStartOf="@id/capsuleBattery"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvAltitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALT: 45.2 m"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPD: 8.5 m/s"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HDG: 180°"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvGps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAT: 18"
                android:textColor="#00FF66"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <!-- BATTERY TELEMETRY CAPSULE -->
        <LinearLayout
            android:id="@+id/capsuleBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_telemetry_capsule"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@id/btnSystem"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ivBatteryIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_battery"
                app:tint="#00FF66" />

            <TextView
                android:id="@+id/tvBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="85%"
                android:textColor="#00FF66"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <!-- SYSTEM SETTINGS GEAR BUTTON -->
        <TextView
            android:id="@+id/btnSystem"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="⚙"
            android:textColor="#00FF66"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/bg_glass_btn"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@id/modeSwitcher"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- DISPLAY MODE SWITCHER PILL (DAY / NIGHT / NVG) -->
        <LinearLayout
            android:id="@+id/modeSwitcher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_mode_switcher"
            android:padding="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/btnModeDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="DAY"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_glass_btn_active" />

            <TextView
                android:id="@+id/btnModeNight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="NIGHT"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnModeNvg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="NVG"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ======================================================= -->
    <!-- 6. LEFT ALERTS & RIGHT ALERTS CONTAINERS                -->
    <!-- ======================================================= -->
    <LinearLayout
        android:id="@+id/alertsLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="@id/reticle"
        app:layout_constraintBottom_toBottomOf="@id/reticle"
        app:layout_constraintEnd_toStartOf="@id/reticle"
        android:layout_marginEnd="16dp">

        <TextView android:id="@+id/alertThermal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THERMAL WARNING" android:textColor="#FF3333" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_tactical_pill_danger" android:padding="6dp" android:visibility="gone" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/alertLow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOW BATTERY" android:textColor="#FF3333" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_tactical_pill_danger" android:padding="6dp" android:visibility="gone" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/alertLoss" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C2 LINK LOSS" android:textColor="#FF3333" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_tactical_pill_danger" android:padding="6dp" android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/alertsRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="@id/reticle"
        app:layout_constraintBottom_toBottomOf="@id/reticle"
        app:layout_constraintStart_toEndOf="@id/reticle"
        android:layout_marginStart="16dp">

        <TextView android:id="@+id/alertStorage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STORAGE FULL" android:textColor="#FF3333" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_tactical_pill_danger" android:padding="6dp" android:visibility="gone" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/alertBlock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NFZ RESTRICTED" android:textColor="#FF3333" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_tactical_pill_danger" android:padding="6dp" android:visibility="gone" />
    </LinearLayout>

    <!-- ======================================================= -->
    <!-- 7. OBSTACLE RADAR OVERLAY                               -->
    <!-- ======================================================= -->
    <com.dji.recreate2.ObstacleRadarView
        android:id="@+id/obstacleRadarView"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerPanel"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ======================================================= -->
    <!-- 8. MAPPING SETTINGS DRAWER / PANEL                     -->
    <!-- ======================================================= -->
    <ScrollView
        android:id="@+id/layoutMappingSettings"
        android:layout_width="260dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_atak_panel"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerPanel"
        app:layout_constraintBottom_toTopOf="@id/tacticalDock">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAPPING GRID PLAN"
                android:textColor="#00FF66"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <!-- Grid Altitude -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Altitude (m)"
                android:textColor="#AAAAAA"
                android:textSize="11sp"/>
            <EditText
                android:id="@+id/etMapAlt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00FF66"
                android:background="@drawable/bg_telemetry_capsule"
                android:padding="8dp"
                android:inputType="numberDecimal"
                android:text="50.0"
                android:layout_marginBottom="10dp"/>

            <!-- Grid Speed -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speed (m/s)"
                android:textColor="#AAAAAA"
                android:textSize="11sp"/>
            <EditText
                android:id="@+id/etMapSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00FF66"
                android:background="@drawable/bg_telemetry_capsule"
                android:padding="8dp"
                android:inputType="numberDecimal"
                android:text="5.0"
                android:layout_marginBottom="10dp"/>

            <!-- Side Overlap -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Side Overlap (%)"
                android:textColor="#AAAAAA"
                android:textSize="11sp"/>
            <EditText
                android:id="@+id/etMapOverlap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00FF66"
                android:background="@drawable/bg_telemetry_capsule"
                android:padding="8dp"
                android:inputType="number"
                android:text="70"
                android:layout_marginBottom="10dp"/>

            <!-- Gimbal Pitch -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gimbal Pitch (deg)"
                android:textColor="#AAAAAA"
                android:textSize="11sp"/>
            <EditText
                android:id="@+id/etMapPitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00FF66"
                android:background="@drawable/bg_telemetry_capsule"
                android:padding="8dp"
                android:inputType="numberSigned"
                android:text="-90"
                android:layout_marginBottom="10dp"/>

            <!-- KMZ Import Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/btnImportKmzLocal"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="STORAGE"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:background="@drawable/bg_glass_btn"
                    android:layout_marginEnd="4dp"/>
                <Button
                    android:id="@+id/btnImportKmz"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="URL"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:background="@drawable/bg_glass_btn"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ======================================================= -->
    <!-- 9. PIP SECONDARY SURFACE (THERMAL / SUB FEED / MINIMAP) -->
    <!-- ======================================================= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/pipCardView"
        android:layout_width="160dp"
        android:layout_height="90dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#CC0D1117"
        app:layout_constraintTop_toBottomOf="@id/headerPanel"
        app:layout_constraintEnd_toEndOf="parent">

        <SurfaceView
            android:id="@+id/pipSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

    <!-- ======================================================= -->
    <!-- 10. VIRTUAL JOYSTICK OVERLAY CONTAINER                  -->
    <!-- ======================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/joystickContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.dji.recreate2.virtualstick.OnScreenJoystick
            android:id="@+id/leftJoystick"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="48dp"
            android:layout_marginStart="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.dji.recreate2.virtualstick.OnScreenJoystick
            android:id="@+id/rightJoystick"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="48dp"
            android:layout_marginEnd="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ======================================================= -->
    <!-- 11. BOTTOM ATAK TACTICAL DOCK (SLEEK & COMPACT)          -->
    <!-- ======================================================= -->
    <LinearLayout
        android:id="@+id/tacticalDock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_tactical_dock"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:gravity="center"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TAKEOFF ACTION BUTTON -->
        <Button
            android:id="@+id/btnTakeoff"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="TAKEOFF"
            android:textColor="#00FF66"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline_green"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="8dp" />

        <!-- LAND ACTION BUTTON -->
        <Button
            android:id="@+id/btnLand"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="LAND"
            android:textColor="#FFCC00"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline_green"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="8dp" />

        <!-- RTH ACTION BUTTON -->
        <Button
            android:id="@+id/btnRth"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="RTH"
            android:textColor="#FF3333"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline_red"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="8dp" />

        <!-- TOGGLE MAP BUTTON -->
        <Button
            android:id="@+id/btnToggleMap"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="MAP"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_btn"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="8dp" />

        <!-- ROUTE MANAGER BUTTON -->
        <Button
            android:id="@+id/btnRouteManager"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="ROUTES"
            android:textColor="#00FF66"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_btn"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="8dp" />

        <!-- MAPPING GRID SURVEY BUTTON -->
        <Button
            android:id="@+id/btnModeShape"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="GRID"
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_btn"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="8dp" />

        <!-- CAMERA PHOTO BUTTON -->
        <Button
            android:id="@+id/btnCapture"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="📷 PHOTO"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_btn"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="8dp" />

        <!-- CAMERA VIDEO BUTTON -->
        <Button
            android:id="@+id/btnRecordVideo"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="🔴 REC"
            android:textColor="#FF3333"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_btn"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="8dp" />

        <!-- VIRTUAL JOYSTICK TOGGLE BUTTON -->
        <Button
            android:id="@+id/btnToggleJoysticks"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="JOYSTICK"
            android:textColor="#00FF66"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_btn"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="8dp" />

        <!-- STREAM RELAY BUTTON -->
        <Button
            android:id="@+id/btnStreamRelay"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="STREAM"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_btn"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- ======================================================= -->
    <!-- 12. NIGHT & NVG OVERLAY TINT FILTERS                    -->
    <!-- ======================================================= -->
    <View
        android:id="@+id/viewNightFilter"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#40FF0000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/viewNvgFilter"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#4000FF00"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
