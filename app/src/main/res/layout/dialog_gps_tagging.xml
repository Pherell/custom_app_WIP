<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#DD0F172A"
    android:padding="20dp">

    <!-- DIALOG HEADER -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 TACTICAL GPS TARGET INTEL &amp; TAGS"
        android:textColor="#00FF66"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:gravity="center_horizontal"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stored Target Coordinates for TGP Geo-Lock &amp; Camera POI"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- TOP CONTROL BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnTagCurrentPos"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="+ TAG DRONE POS"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_btn"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnTagTgpTarget"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="+ TAG TGP TARGET"
            android:textColor="#FFFF00"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_btn"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnClearAllTags"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="CLEAR ALL"
            android:textColor="#FF3333"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_btn" />
    </LinearLayout>

    <!-- LIST OF TAGGED COORDINATES -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="#1E293B"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/containerGpsTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- CLOSE BUTTON -->
    <Button
        android:id="@+id/btnCloseTagsDialog"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="CLOSE"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_glass_btn"
        android:layout_marginTop="16dp" />

</LinearLayout>
